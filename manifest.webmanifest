{
 "name": "Vistoria in loco",
 "short_name": "Vistoria",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "background_color": "#FFFFFF",
 "theme_color": "#0B3D91",
 "lang": "pt-BR",
 "icons": [
  {
   "src": "icones/icone-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icones/icone-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./receber-pacote",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "pacote",
     "accept": [
      ".vistoria",
      ".json",
      "application/json",
      "application/octet-stream",
      "text/plain",
      "*/*"
     ]
    }
   ]
  }
 }
}
